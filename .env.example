APP_NAME="Bokko Tuki"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Dakar

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=allodakar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@allodakar.sn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Allo Dakar — business rules (overridable at runtime from the admin backoffice)
#--------------------------------------------------------------------------
# Commission fraction taken by Allo Dakar on each booking (0.05 = 5%).
ALLODAKAR_COMMISSION_RATE=0.05
# Outstanding commission-debt ceiling (FCFA) blocking new bookings/publications.
ALLODAKAR_MAX_COMMISSION_DEBT=50000
# Minimum lead time (hours) before departure allowing a passenger cancellation.
ALLODAKAR_CANCELLATION_DEADLINE_HOURS=2
# Lead time (hours) before departure to send passenger reminders.
ALLODAKAR_REMINDER_LEAD_HOURS=24

#--------------------------------------------------------------------------
# Mobile Money webhook
#--------------------------------------------------------------------------
# Shared secret sent as the X-Webhook-Secret header by the provider.
# NEVER commit the real value — set it only in the server .env.
ALLODAKAR_MOMO_WEBHOOK_SECRET=

#--------------------------------------------------------------------------
# SMS gateway
#--------------------------------------------------------------------------
# Driver used by App\Contracts\SmsSender ("log" writes to the log in dev).
SMS_DRIVER=log
